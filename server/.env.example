# =============================================================================
# CredXP API — Environment contract (Phase 1)
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- MongoDB (current primary — unchanged in Phase 1) ---
MONGODB_URI=mongodb://localhost:27017/credxp

# --- Neon PostgreSQL (dual-run preparation) ---
# Neon dev branch connection string (pooled recommended for serverless/VPS)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/credxp?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/credxp?sslmode=require

# --- Database provider (Phase 4 — default mongo, production unchanged) ---
DB_PROVIDER=mongo

# --- Dual-run flags (Phase 3+) ---
# Which database answers reads/writes once services are migrated
DB_PRIMARY=mongo
# Enable shadow writes to PostgreSQL during dual-run (Phase 3+)
DB_DUAL_WRITE=false
# Log Prisma query timing in development
PRISMA_LOG_QUERIES=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS / URLs ---
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# --- Proposal PDF (Puppeteer) ---
# Shared secret between API and Next.js export page (must match client PDF_EXPORT_SECRET)
PDF_EXPORT_SECRET=change-me-to-a-long-random-string
# Optional: path to Chromium when not using bundled Puppeteer (production Docker/Render)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Render: leave unset. Chrome's cache directory is pinned inside node_modules
# via ../.puppeteerrc.cjs so it survives Render's node_modules build cache.
# If Chrome still isn't found after a deploy, set the Render Build Command to
# `npm install && npx puppeteer browsers install chrome` and redeploy with
# "Clear build cache" once.
# PUPPETEER_CACHE_DIR=/opt/render/project/.puppeteer

# --- Cloudinary (Phase 2 — image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Zoho CRM property sync ---
# Webhook password. Zoho sends it as the x-zoho-webhook-secret header or ?secret= in the URL.
# The webhook is switched off until this is set.
ZOHO_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Zoho API (Self Client in api-console.zoho.in, scope ZohoCRM.modules.READ,ZohoCRM.settings.fields.READ).
# Needed for "Import from Zoho" and to fetch the full record when a webhook arrives.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data centre: in (zoho.in, default), com, eu, com.au, jp, ca, sa
ZOHO_DC=in
# API name of the Zoho module that holds listings
ZOHO_PROPERTY_MODULE=Properties
# Optional automatic pull every N minutes (min 15). Leave blank to rely on webhooks + manual import.
ZOHO_SYNC_INTERVAL_MINUTES=

# --- Form inquiry emails (Resend, https://resend.com) ---
# Without RESEND_API_KEY forms still save, but no email is sent.
RESEND_API_KEY=
# Comma-separated recipients
INQUIRY_EMAIL_TO=credxp5@gmail.com
# Leave blank to use Resend's test sender (only delivers to the Resend account's own email).
# After verifying credxp.com in Resend, use e.g. CredXP Website <inquiries@credxp.com>
INQUIRY_EMAIL_FROM=

# --- WhatsApp OTP login (BhashSMS) ---
# Without these, the "Send code" step returns an error in production;
# in development the code is printed to the server log instead.
BHASH_USER=
BHASH_PASS=
# Name of your approved WhatsApp OTP template (its only variable is the code)
BHASH_OTP_TEMPLATE=
# Optional: sender id (default BUZWAP), message type (auth for OTP templates, normal for utility),
# phone format (10 = 9876543210, 91 = 919876543210), API URL
BHASH_WA_SENDER=
BHASH_OTP_STYPE=
BHASH_PHONE_FORMAT=
BHASH_API_URL=

# --- Optional: external APIs ---
# INSIGHTS_RSS_URL=
