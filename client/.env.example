# Next.js Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
INTERNAL_API_URL=http://localhost:5000/api

# Site Configuration - REQUIRED FOR SEO
NEXT_PUBLIC_APP_URL=https://www.credxp.com

# Google Search Console Verification - REQUIRED FOR INDEXING
# Get this from Google Search Console > Settings > Verification > HTML tag
# Copy the content attribute value from the meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
